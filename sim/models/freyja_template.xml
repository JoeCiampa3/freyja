<mujoco model="freyja">
    <compiler angle="degree"/>
    <option timestep="0.002" gravity="0 0 -9.81"/>
    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.4 0.6 0.8" rgb2="0 0 0" width="512" height="3072" mark="random" markrgb="1 1 1"/>
    </asset> 

    <worldbody>
        <geom name="floor" type="plane" size="10 10 0.1"  pos="0 0 0"/> <!--floor must be at z=0: the sheet's pelvis pos_z is the standing height above it--> <!--design choice, no sheet source-->
        <light pos="0 0 3" dir="0 0 -1"/>

        <body name="pelvis" pos="!{pelvis_pos_x} !{pelvis_pos_y} !{pelvis_pos_z}">
            <inertial pos="${pelvis_com_x} ${pelvis_com_y} ${pelvis_com_z}" mass="${pelvis_mass}" fullinertia="${pelvis_ixx} ${pelvis_iyy} ${pelvis_izz} ${pelvis_ixy} ${pelvis_ixz} ${pelvis_iyz}"/>
            <geom type="capsule" fromto="!{thigh_right_pos_x} !{thigh_right_pos_y} !{thigh_right_pos_z} !{thigh_right_pos_x} !{thigh_left_pos_y} !{thigh_right_pos_z}" size="!{pelvis_radius}" mass="0" rgba="0.82 0.71 0.55 1.0"/> <!--hip girdle: capsule centres on the hip joint centres-->
            <geom type="ellipsoid" pos="0 0 !{pelvis_mid_z}" size="0.08 0.13 !{pelvis_half_z}" mass="0" rgba="0.82 0.71 0.55 1.0"/> <!--iliac wings; reaches up into the abdomen--> <!--design choice, no sheet source-->
            <joint type="free"/>

            <body name="thigh_right" pos="!{thigh_right_pos_x} !{thigh_right_pos_y} !{thigh_right_pos_z}">
                <inertial pos="${thigh_right_com_x} ${thigh_right_com_y} ${thigh_right_com_z}" mass="${thigh_right_mass}" fullinertia="${thigh_right_ixx} ${thigh_right_iyy} ${thigh_right_izz} ${thigh_right_ixy} ${thigh_right_ixz} ${thigh_right_iyz}"/>
                <geom type="capsule" fromto="0 0 !{thigh_right_cap_top_z} 0 0 !{thigh_right_cap_bot_z}" size="!{thigh_right_radius}" mass="0" rgba="0.82 0.71 0.55 1.0"/> <!--end spheres touch both joints-->
                <joint name="hip_fe_right" type="hinge" axis="0 -1 0" limited="true" range="!{-hip_extension} !{hip_flexion}"/> <!--fe=flexion/extension-->
                <joint name="hip_aa_right" type="hinge" axis="1 0 0" limited="true" range="!{-hip_abduction} !{hip_adduction}"/> <!--aa=ab/adduction-->
                <joint name="hip_ier_right" type="hinge" axis="0 0 1" limited="true" range="!{-hip_external_rotation} !{hip_internal_rotation}"/> <!--ier=internal/external rotation-->

                <body name="shank_right" pos="!{shank_right_pos_x} !{shank_right_pos_y} !{shank_right_pos_z}">
                    <inertial pos="${shank_right_com_x} ${shank_right_com_y} ${shank_right_com_z}" mass="${shank_right_mass}" fullinertia="${shank_right_ixx} ${shank_right_iyy} ${shank_right_izz} ${shank_right_ixy} ${shank_right_ixz} ${shank_right_iyz}"/>
                    <geom type="capsule" fromto="0 0 !{shank_right_cap_top_z} 0 0 !{shank_right_cap_bot_z}" size="!{shank_right_radius}" mass="0" rgba="0.82 0.71 0.55 1.0"/> <!--end spheres touch both joints-->
                    <geom type="sphere" pos="0 0 0" size="!{knee_right_sphere_radius}" mass="0" rgba="0.82 0.71 0.55 1.0"/> <!--centred on the knee-->
                    <joint name="knee_right" type="hinge" axis="0 1 0" limited="true" range="!{-knee_extension} !{knee_flexion}"/>

                    <body name="foot_right" pos="!{foot_right_pos_x} !{foot_right_pos_y} !{foot_right_pos_z}">
                        <inertial pos="${foot_right_com_x} ${foot_right_com_y} ${foot_right_com_z}" mass="${foot_right_mass}" fullinertia="${foot_right_ixx} ${foot_right_iyy} ${foot_right_izz} ${foot_right_ixy} ${foot_right_ixz} ${foot_right_iyz}"/>
                        <geom type="box" pos="!{foot_right_box_pos_x} 0 !{foot_right_box_pos_z}" size="!{foot_right_box_half_x} 0.050 !{foot_right_box_half_z}" friction="1.0 0.005 0.0001" condim="3" rgba="0.82 0.71 0.55 1.0"/> <!--sole on the floor at neutral. extend condim to 4 for foot turning--> <!--design choice, no sheet source-->
                        <site name="site_sole_right" pos="0 0 !{foot_right_sole_z}"/> <!--ankle joint centre minus the ankle height: the floor at neutral-->
                        <joint name="ankle_pdflex_right" type="hinge" axis="0 -1 0" limited="true" range="!{-ankle_plantarflexion} !{ankle_dorsiflexion}"/> <!--pdflex=plantar/dorsiflexion-->
                        <joint name="ankle_ie_right" type="hinge" axis="1 0 0" limited="true" range="!{-ankle_eversion} !{ankle_inversion}"/> <!--ie=inversion/eversion-->
                    </body>
                </body>
            </body>

            <!--mirroring in y. "0 1 0" axis stays unchanged "1 0 0" and "0 0 1" flip signs as do all com, position, and inertial elements involving y-->
            <body name="thigh_left" pos="!{thigh_left_pos_x} !{thigh_left_pos_y} !{thigh_left_pos_z}">
                <inertial pos="${thigh_left_com_x} ${thigh_left_com_y} ${thigh_left_com_z}" mass="${thigh_left_mass}" fullinertia="${thigh_left_ixx} ${thigh_left_iyy} ${thigh_left_izz} ${thigh_left_ixy} ${thigh_left_ixz} ${thigh_left_iyz}"/>
                <geom type="capsule" fromto="0 0 !{thigh_left_cap_top_z} 0 0 !{thigh_left_cap_bot_z}" size="!{thigh_left_radius}" mass="0" rgba="0.82 0.71 0.55 1.0"/> <!--end spheres touch both joints-->
                <joint name="hip_fe_left" type="hinge" axis="0 -1 0" limited="true" range="!{-hip_extension} !{hip_flexion}"/> <!--fe=flexion/extension-->
                <joint name="hip_aa_left" type="hinge" axis="-1 0 0" limited="true" range="!{-hip_abduction} !{hip_adduction}"/> <!--aa=ab/adduction-->
                <joint name="hip_ier_left" type="hinge" axis="0 0 -1" limited="true" range="!{-hip_external_rotation} !{hip_internal_rotation}"/> <!--ier=internal/external rotation-->

                <body name="shank_left" pos="!{shank_left_pos_x} !{shank_left_pos_y} !{shank_left_pos_z}">
                    <inertial pos="${shank_left_com_x} ${shank_left_com_y} ${shank_left_com_z}" mass="${shank_left_mass}" fullinertia="${shank_left_ixx} ${shank_left_iyy} ${shank_left_izz} ${shank_left_ixy} ${shank_left_ixz} ${shank_left_iyz}"/>
                    <geom type="capsule" fromto="0 0 !{shank_left_cap_top_z} 0 0 !{shank_left_cap_bot_z}" size="!{shank_left_radius}" mass="0" rgba="0.82 0.71 0.55 1.0"/> <!--end spheres touch both joints-->
                    <geom type="sphere" pos="0 0 0" size="!{knee_left_sphere_radius}" mass="0" rgba="0.82 0.71 0.55 1.0"/> <!--centred on the knee-->
                    <joint name="knee_left" type="hinge" axis="0 1 0" limited="true" range="!{-knee_extension} !{knee_flexion}"/>

                    <body name="foot_left" pos="!{foot_left_pos_x} !{foot_left_pos_y} !{foot_left_pos_z}">
                        <inertial pos="${foot_left_com_x} ${foot_left_com_y} ${foot_left_com_z}" mass="${foot_left_mass}" fullinertia="${foot_left_ixx} ${foot_left_iyy} ${foot_left_izz} ${foot_left_ixy} ${foot_left_ixz} ${foot_left_iyz}"/>
                        <geom type="box" pos="!{foot_left_box_pos_x} 0 !{foot_left_box_pos_z}" size="!{foot_left_box_half_x} 0.050 !{foot_left_box_half_z}" friction="1.0 0.005 0.0001" condim="3" rgba="0.82 0.71 0.55 1.0"/> <!--sole on the floor at neutral. extend condim to 4 for foot turning--> <!--design choice, no sheet source-->
                        <site name="site_sole_left" pos="0 0 !{foot_left_sole_z}"/> <!--ankle joint centre minus the ankle height: the floor at neutral-->
                        <joint name="ankle_pdflex_left" type="hinge" axis="0 -1 0" limited="true" range="!{-ankle_plantarflexion} !{ankle_dorsiflexion}"/> <!--pdflex=plantar/dorsiflexion-->
                        <joint name="ankle_ie_left" type="hinge" axis="-1 0 0" limited="true" range="!{-ankle_eversion} !{ankle_inversion}"/> <!--ie=inversion/eversion-->
                    </body>
                </body>
            </body>

            <!--spine joints: pos="0 0 jpos_z" puts the hinge at the joint centre (e.g. the lumbosacral joint, below the abdomen origin) instead of at the body origin-->
            <body name="abdomen" pos="!{abdomen_pos_x} !{abdomen_pos_y} !{abdomen_pos_z}">
                <inertial pos="${abdomen_com_x} ${abdomen_com_y} ${abdomen_com_z}" mass="${abdomen_mass}" fullinertia="${abdomen_ixx} ${abdomen_iyy} ${abdomen_izz} ${abdomen_ixy} ${abdomen_ixz} ${abdomen_iyz}"/>
                <geom type="ellipsoid" pos="0 0 !{abdomen_mid_z}" size="0.08 0.10 !{abdomen_half_z}" mass="0" rgba="0.82 0.71 0.55 1.0"/> <!--waist; overlaps the pelvis and thorax so there is no pinch--> <!--design choice, no sheet source-->
                <joint name="lsj_fe" type="hinge" pos="0 0 !{abdomen_jpos_z}" axis="0 -1 0" limited="true" range="!{-lumbosacral_extension} !{lumbosacral_flexion}"/> <!--lsj_fe= lumbrosacral joint flexion/extension. ROM fills in automatically once it is in the sheet-->
                <joint name="lsj_lat" type="hinge" pos="0 0 !{abdomen_jpos_z}" axis="1 0 0" limited="true" range="!{-lumbosacral_lateral_bending} !{lumbosacral_lateral_bending}"/> <!--lsj_lat= lumbrosacral joint lateral bending. ROM fills in automatically once it is in the sheet-->
                <joint name="lsj_ax" type="hinge" pos="0 0 !{abdomen_jpos_z}" axis="0 0 1" limited="true" range="!{-lumbosacral_axial_rotation} !{lumbosacral_axial_rotation}"/> <!--lsj_ax= lumbosacral joint axial bending. ROM fills in automatically once it is in the sheet-->


                <body name="thorax" pos="!{thorax_pos_x} !{thorax_pos_y} !{thorax_pos_z}">
                    <inertial pos="${thorax_com_x} ${thorax_com_y} ${thorax_com_z}" mass="${thorax_mass}" fullinertia="${thorax_ixx} ${thorax_iyy} ${thorax_izz} ${thorax_ixy} ${thorax_ixz} ${thorax_iyz}"/>
                    <geom type="ellipsoid" pos="0 0 !{thorax_mid_z}" size="0.10 0.13 !{thorax_half_z}" mass="0" rgba="0.82 0.71 0.55 1.0"/> <!--rib cage, spans joint to joint--> <!--design choice, no sheet source-->
                    <geom type="ellipsoid" pos="0 0 !{thorax_chest_z}" size="0.105 0.16 !{thorax_chest_half_z}" mass="0" rgba="0.82 0.71 0.55 1.0"/> <!--upper chest: fills out towards the shoulders--> <!--design choice, no sheet source-->
                    <geom type="capsule" fromto="!{upper_arm_right_pos_x} !{upper_arm_right_pos_y} !{upper_arm_right_pos_z} !{upper_arm_left_pos_x} !{upper_arm_left_pos_y} !{upper_arm_left_pos_z}" size="!{shoulder_radius}" mass="0" rgba="0.82 0.71 0.55 1.0"/> <!--shoulder girdle: centres on the shoulder joint centres-->
                    <geom type="capsule" fromto="0 0 !{trapezius_start_z} !{upper_arm_right_pos_x} !{upper_arm_right_pos_y} !{upper_arm_right_pos_z}" size="!{trapezius_radius}" mass="0" rgba="0.82 0.71 0.55 1.0"/> <!--trapezius: neck base to shoulder-->
                    <geom type="capsule" fromto="0 0 !{trapezius_start_z} !{upper_arm_left_pos_x} !{upper_arm_left_pos_y} !{upper_arm_left_pos_z}" size="!{trapezius_radius}" mass="0" rgba="0.82 0.71 0.55 1.0"/>
                    <joint name="tj_fe" type="hinge" pos="0 0 !{thorax_jpos_z}" axis="0 -1 0" /> <!--tj_fe= thoracic joint flexion/extension. FIXME add rom when available-->
                    <joint name="tj_lat" type="hinge" pos="0 0 !{thorax_jpos_z}" axis="1 0 0"/> <!--tj_lat= thoracic  joint lateral bending FIXME add rom when available-->
                    <joint name="tj_ax" type="hinge" pos="0 0 !{thorax_jpos_z}" axis="0 0 1"/> <!--tj_ax= thoracic  joint axial bending FIXME add rom when available-->

                    <body name="upper_arm_right" pos="!{upper_arm_right_pos_x} !{upper_arm_right_pos_y} !{upper_arm_right_pos_z}">
                        <inertial pos="${upper_arm_right_com_x} ${upper_arm_right_com_y} ${upper_arm_right_com_z}" mass="${upper_arm_right_mass}" fullinertia="${upper_arm_right_ixx} ${upper_arm_right_iyy} ${upper_arm_right_izz} ${upper_arm_right_ixy} ${upper_arm_right_ixz} ${upper_arm_right_iyz}"/>
                        <geom type="capsule" fromto="0 0 !{upper_arm_right_cap_top_z} 0 0 !{upper_arm_right_cap_bot_z}" size="!{upper_arm_right_radius}" mass="0" rgba="0.82 0.71 0.55 1.0"/> <!--end spheres touch both joints-->
                        <joint name="shoulder_fe_right" type="hinge" axis="0 -1 0" limited="true" range="!{-shoulder_extension} !{shoulder_flexion}"/>    <!--fe=flexion/extension--> <!--placeholder shoulder architecture-->
                        <joint name="shoulder_aa_right" type="hinge" axis="1 0 0" limited="true" range="!{-shoulder_abduction} !{shoulder_adduction}"/>    <!--aa=ab/adduction-->
                        <joint name="shoulder_ier_right" type="hinge" axis="0 0 1" limited="true" range="!{-shoulder_external_rotation} !{shoulder_internal_rotation}"/>   <!--ier=int/external rotation-->


                        <body name="forearm_right" pos="!{forearm_right_pos_x} !{forearm_right_pos_y} !{forearm_right_pos_z}">
                            <inertial pos="${forearm_right_com_x} ${forearm_right_com_y} ${forearm_right_com_z}" mass="${forearm_right_mass}" fullinertia="${forearm_right_ixx} ${forearm_right_iyy} ${forearm_right_izz} ${forearm_right_ixy} ${forearm_right_ixz} ${forearm_right_iyz}"/>
                            <geom type="capsule" fromto="0 0 !{forearm_right_cap_top_z} 0 0 !{forearm_right_cap_bot_z}" size="!{forearm_right_radius}" mass="0" rgba="0.82 0.71 0.55 1.0"/> <!--end spheres touch both joints-->
                            <joint name="elbow_right" type="hinge" axis="0 -1 0" limited="true" range="!{-elbow_extension} !{elbow_flexion}"/>

                                <body name="hand_right" pos="!{hand_right_pos_x} !{hand_right_pos_y} !{hand_right_pos_z}">
                                    <inertial pos="${hand_right_com_x} ${hand_right_com_y} ${hand_right_com_z}" mass="${hand_right_mass}" fullinertia="${hand_right_ixx} ${hand_right_iyy} ${hand_right_izz} ${hand_right_ixy} ${hand_right_ixz} ${hand_right_iyz}"/>
                                    <geom type="ellipsoid" pos="0 0 !{hand_right_mid_z}" size="0.04 0.015 !{hand_right_half_z}" mass="0" rgba="0.82 0.71 0.55 1.0"/> <!--wrist to fingertip end--> <!--design choice, no sheet source-->
                                    <joint name="wrist_right" type="hinge" axis="1 0 0" limited="true" range="!{-wrist_extension} !{wrist_flexion}"/>
                                </body>
                        </body>
                    </body>

                    <body name="upper_arm_left" pos="!{upper_arm_left_pos_x} !{upper_arm_left_pos_y} !{upper_arm_left_pos_z}">
                        <inertial pos="${upper_arm_left_com_x} ${upper_arm_left_com_y} ${upper_arm_left_com_z}" mass="${upper_arm_left_mass}" fullinertia="${upper_arm_left_ixx} ${upper_arm_left_iyy} ${upper_arm_left_izz} ${upper_arm_left_ixy} ${upper_arm_left_ixz} ${upper_arm_left_iyz}"/>
                        <geom type="capsule" fromto="0 0 !{upper_arm_left_cap_top_z} 0 0 !{upper_arm_left_cap_bot_z}" size="!{upper_arm_left_radius}" mass="0" rgba="0.82 0.71 0.55 1.0"/> <!--end spheres touch both joints-->
                        <joint name="shoulder_fe_left" type="hinge" axis="0 -1 0" limited="true" range="!{-shoulder_extension} !{shoulder_flexion}"/>    <!--fe=flexion/extension--> <!--placeholder shoulder architecture-->
                        <joint name="shoulder_aa_left" type="hinge" axis="-1 0 0" limited="true" range="!{-shoulder_abduction} !{shoulder_adduction}"/>    <!--aa=ab/adduction-->
                        <joint name="shoulder_ier_left" type="hinge" axis="0 0 -1" limited="true" range="!{-shoulder_external_rotation} !{shoulder_internal_rotation}"/>   <!--ier=int/external rotation-->

                        <body name="forearm_left" pos="!{forearm_left_pos_x} !{forearm_left_pos_y} !{forearm_left_pos_z}">
                            <inertial pos="${forearm_left_com_x} ${forearm_left_com_y} ${forearm_left_com_z}" mass="${forearm_left_mass}" fullinertia="${forearm_left_ixx} ${forearm_left_iyy} ${forearm_left_izz} ${forearm_left_ixy} ${forearm_left_ixz} ${forearm_left_iyz}"/>
                            <geom type="capsule" fromto="0 0 !{forearm_left_cap_top_z} 0 0 !{forearm_left_cap_bot_z}" size="!{forearm_left_radius}" mass="0" rgba="0.82 0.71 0.55 1.0"/> <!--end spheres touch both joints-->
                            <joint name="elbow_left" type="hinge" axis="0 -1 0" limited="true" range="!{-elbow_extension} !{elbow_flexion}"/>

                                <body name="hand_left" pos="!{hand_left_pos_x} !{hand_left_pos_y} !{hand_left_pos_z}">
                                    <inertial pos="${hand_left_com_x} ${hand_left_com_y} ${hand_left_com_z}" mass="${hand_left_mass}" fullinertia="${hand_left_ixx} ${hand_left_iyy} ${hand_left_izz} ${hand_left_ixy} ${hand_left_ixz} ${hand_left_iyz}"/>
                                    <geom type="ellipsoid" pos="0 0 !{hand_left_mid_z}" size="0.04 0.015 !{hand_left_half_z}" mass="0" rgba="0.82 0.71 0.55 1.0"/> <!--wrist to fingertip end--> <!--design choice, no sheet source-->
                                    <joint name="wrist_left" type="hinge" axis="-1 0 0" limited="true" range="!{-wrist_extension} !{wrist_flexion}"/>

                                </body>
                        </body>
                    </body>

                    <body name="head_and_neck" pos="!{head_neck_pos_x} !{head_neck_pos_y} !{head_neck_pos_z}">
                        <inertial pos="${head_neck_com_x} ${head_neck_com_y} ${head_neck_com_z}" mass="${head_neck_mass}" fullinertia="${head_neck_ixx} ${head_neck_iyy} ${head_neck_izz} ${head_neck_ixy} ${head_neck_ixz} ${head_neck_iyz}"/>
                        <geom type="ellipsoid" pos="0 0 !{head_neck_head_z}" size="0.09 0.072 !{head_neck_head_half_z}" mass="0" rgba="0.82 0.71 0.55 1.0"/> <!--top of the head is the vertex--> <!--design choice, no sheet source-->
                        <geom type="capsule" fromto="0 0 !{head_neck_neck_start_z} 0 0 !{head_neck_head_z}" size="!{head_neck_neck_radius}" mass="0" rgba="0.82 0.71 0.55 1.0"/> <!--neck: tip at the cervical joint, ends in the head-->
                        <site name="site_vertex" pos="0 0 !{head_neck_length}"/> <!--vertex = cervical joint + head_neck_length; the stature check reads it-->
                        <joint name="cj_fe" type="hinge" axis="0 -1 0" /> <!--cj_fe= cervical joint flexion/extension. FIXME add rom when available-->
                        <joint name="cj_lat" type="hinge" axis="1 0 0"/> <!--cj_lat= cervical  joint lateral bending FIXME add rom when available-->
                        <joint name="cj_ax" type="hinge" axis="0 0 1"/> <!--cj_ax= cervical  joint axial bending FIXME add rom when available-->
                    </body>
                </body>
            </body>
        </body>
    </worldbody>
</mujoco>
