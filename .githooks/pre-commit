#!/bin/sh
# Freyja pre-commit: rebuild the roadmap's generated files and stage exactly those two. Blocks the commit when the roadmap has errors.
# Enable per clone with `python tools/fy roadmap install-hooks`.
set -e
cd "$(git rev-parse --show-toplevel)"
if [ -n "$FREYJA_PYTHON" ]; then
    PY="$FREYJA_PYTHON"
elif [ -x .venv/Scripts/python.exe ]; then
    PY=.venv/Scripts/python.exe
elif [ -x .venv/bin/python ]; then
    PY=.venv/bin/python
else
    PY=python
fi
"$PY" tools/fy roadmap build
git add -- roadmap/state.json roadmap/STATUS.md
