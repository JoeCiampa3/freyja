#!/bin/sh
# Freyja pre-commit: rebuild the roadmap's generated files and stage exactly those two, then rebuild the thread's generated outputs and stage them.
# Blocks the commit, with the error text, when the roadmap or the thread has errors.
# Enable per clone with `python tools/fy roadmap install-hooks`.
set -e
cd "$(git rev-parse --show-toplevel)"
if [ -n "$FREYJA_PYTHON" ]; then
    PY="$FREYJA_PYTHON"
elif [ -x .venv/Scripts/python.exe ]; then
    PY=.venv/Scripts/python.exe
elif [ -x .venv/bin/python ]; then
    PY=.venv/bin/python
else
    PY=python
fi
"$PY" tools/fy roadmap build
git add -- roadmap/state.json roadmap/STATUS.md
if [ -d thread ]; then
    "$PY" tools/fy thread build
    git add -A -- thread/derived thread/dossiers thread/graph.json thread/STATUS.md
fi
