# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Local / machine-specific
local_config.json
archive/
data/literature
data/ansur2/raw
data/envelope/cache
# Roadmap viewer pins: personal, per clone
roadmap/.pins.json

# Simulation logs
MUJOCO_LOG.TXT

# OS / editor
.DS_Store
Thumbs.db
.vscode/

# Secrets (also covered in sim/.gitignore)
project-valkyrie-*.json
*service-account*.json
*service_account*.json
*credentials*.json
*.pem

# Build leftovers
sim/models/freyja_FAILED.xml
sim/archive/

# Last advisory results written by the build gate
checks/last_run.json

# Run records: raw timeseries stay out of git (CONVENTIONS section 6); summary.json is tracked
sim/runs/*/raw.npz
sim/sweeps/*/sweep.json
data/camargo2021/raw
data/camargo2021/scripts.zip
data/camargo2021/processed
sim/gait/*/gait.json
data/makehuman/cache

# CAD bridge: the STEP export is the FEA hand-off format; its header carries a timestamp, so only its normalised hash is tracked (the sidecar)
cad/exports/*.step
