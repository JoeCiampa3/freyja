{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "segment-characterization/1",
  "title": "segment-characterization/1",
  "description": "One segment's characterization: what the world and the task demand of it, the room it has, the range it moves through and where its interfaces sit (adr-0045; docs/briefs/ariadne/upper-arm-characterization-brief.md, T4). Generated by the segment's characterization work item at data/characterization/<segment name>.json; segment-generic. Right-side CAD frame (CONVENTIONS section 3), mm, degrees, N and N m. Every value is read from an address the work item consumes, computed from those by committed code, or read from the segment's authored inputs file (characterization-inputs/1). It carries nothing from an actuator (adr-0045 D1) and no bolt circle, clocking, fastener, dowel, compliance stroke or overload stop (adr-0045 D3). Banner keys, no timestamps.",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated_by", "inputs", "schema", "segment", "side", "frame", "anchors", "interfaces", "rom", "volume", "load_cases", "consumes"],
  "properties": {
    "generated_by": {"type": "string", "minLength": 1, "description": "Banner (CONVENTIONS section 4)."},
    "inputs": {"type": "string", "pattern": "^sha256:[0-9a-f]{12}$", "description": "Banner: the hash of the inputs."},
    "schema": {"const": "segment-characterization/1"},
    "segment": {"$ref": "#/$defs/segment_id"},
    "side": {"const": "right"},
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "origin", "axes", "units"],
      "properties": {
        "statement": {"type": "string", "minLength": 1, "description": "The frame in words: right-side ISB/CAD segment frame, origin, axes, posture."},
        "origin": {"type": "string", "minLength": 1, "description": "The anchor at the origin (a key of `anchors`)."},
        "axes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "z"],
          "properties": {"x": {"type": "string"}, "y": {"type": "string"}, "z": {"type": "string"}}
        },
        "units": {
          "type": "object",
          "additionalProperties": false,
          "required": ["length", "angle", "force", "moment", "mass", "energy"],
          "properties": {
            "length": {"const": "mm"}, "angle": {"const": "deg"}, "force": {"const": "N"},
            "moment": {"const": "N m"}, "mass": {"const": "kg"}, "energy": {"const": "J"}
          }
        }
      }
    },
    "anchors": {
      "type": "object",
      "description": "The joint nodes the frames are built on, by name (shoulder, elbow, wrist), each with its position and its bar.",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["definition", "position"],
        "properties": {
          "definition": {"type": "string", "minLength": 1, "description": "Which rule places the node (adr-0042 D1, the sheet's SJC through the trunk registration)."},
          "position": {"$ref": "#/$defs/position"}
        }
      }
    },
    "axis_tilt_bound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value_deg", "from", "plane"],
      "description": "atan(bar / length): how far the segment's axis, and so every interface frame, can tilt within the anchors' bars (adr-0045 D6(a)).",
      "properties": {
        "value_deg": {"type": "number", "minimum": 0},
        "from": {"type": "string", "minLength": 1},
        "plane": {"type": "string", "minLength": 1}
      }
    },
    "interfaces": {
      "type": "object",
      "description": "By name (shoulder, elbow): a frame, the bracketing section rows at its station, and the wrench of every case at its origin in that frame (adr-0045 D3).",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/interface"}
    },
    "rom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["joint", "sign", "anatomical", "mechanism", "loaded_arc", "flexion_clearance"],
      "properties": {
        "joint": {"$ref": "#/$defs/joint_id"},
        "sign": {"type": "string", "minLength": 1, "description": "The polarity (checks/joint_polarity.yaml): flexion positive, extension negative."},
        "anatomical": {"$ref": "#/$defs/range"},
        "mechanism": {"$ref": "#/$defs/range"},
        "loaded_arc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_deg", "max_deg", "basis"],
          "properties": {
            "min_deg": {"type": ["number", "null"]},
            "max_deg": {"type": ["number", "null"]},
            "basis": {"type": "string", "minLength": 1},
            "source_needed": {"const": true}
          }
        },
        "flexion_clearance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "inner_first_contact_deg", "rows"],
          "properties": {
            "source": {"type": "string", "minLength": 1, "description": "The generated file it is read from, by address."},
            "inner_first_contact_deg": {"type": ["number", "null"], "description": "The angle at which the inner shells first touch; null if they do not within the travel."},
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["angle_deg", "inner_separation_mm", "skin_interpenetration_mm"],
                "properties": {
                  "angle_deg": {"type": "number"},
                  "inner_separation_mm": {"type": "number"},
                  "skin_interpenetration_mm": {"type": "number"}
                }
              }
            }
          }
        }
      }
    },
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "shell_mm", "inner_volume_l", "stations"],
      "properties": {
        "definition": {"type": "string", "minLength": 1, "description": "The body envelope inside the shell, not the free field (brief decision 7)."},
        "shell_mm": {"type": "number", "exclusiveMinimum": 0},
        "inner_volume_l": {"type": "number", "minimum": 0},
        "stations": {"type": "array", "items": {"$ref": "#/$defs/section_row"}}
      }
    },
    "load_cases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["static", "inertial", "fall"],
      "properties": {
        "static": {"type": "array", "items": {"$ref": "#/$defs/static_row"}},
        "inertial": {"type": "array", "items": {"$ref": "#/$defs/inertial_row"}},
        "fall": {"type": "array", "items": {"$ref": "#/$defs/fall_case"}}
      }
    },
    "open": {
      "type": "array",
      "description": "Quantities the file cannot carry yet, each with its reason and the node or record it waits on.",
      "items": {"$ref": "#/$defs/open_item"}
    },
    "consumes": {
      "type": "array",
      "uniqueItems": true,
      "description": "Every address the generator resolved, sorted; equal to the work item's consumes.",
      "items": {"type": "string", "pattern": "^[^#\\s]+#(/[^\\s]*)?$"}
    }
  },
  "$defs": {
    "segment_id": {"type": "string", "pattern": "^seg[.][a-z0-9_-]+$"},
    "joint_id": {"type": "string", "pattern": "^jnt[.][a-z0-9_-]+$"},
    "case_id": {"type": "string", "pattern": "^lc[.][a-z0-9_-]+$"},
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record", "clause"],
      "properties": {
        "record": {"type": "string", "pattern": "^adr-[0-9]{4}$"},
        "clause": {"type": "string", "pattern": "^D[0-9]+(\\([a-z]\\))?$"}
      }
    },
    "bar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value_mm", "source"],
      "description": "An anchor's error bar: a number a record states, or `unstated`, never 0 (adr-0045 D6).",
      "properties": {
        "value_mm": {"oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"const": "unstated"}]},
        "direction": {"type": "string", "minLength": 1},
        "source": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citation"}}
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mm", "bar"],
      "description": "A point in the file's frame with the bar of the anchor it derives from. A position finer than its bar is inside the anchor's uncertainty.",
      "properties": {
        "mm": {"$ref": "#/$defs/vec3"},
        "bar": {"$ref": "#/$defs/bar"}
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_deg", "max_deg", "basis"],
      "properties": {
        "min_deg": {"type": "number"},
        "max_deg": {"type": "number"},
        "basis": {"type": "string", "minLength": 1}
      }
    },
    "ray": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mm", "label"],
      "properties": {
        "mm": {"type": "number"},
        "label": {"enum": ["skin", "cut_plane"], "description": "By the ledger's own definition of its rays."}
      }
    },
    "section_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["station_mm", "y_mm", "values"],
      "description": "One ledger row as the ledger holds it: its station (distance below the top of the field), its CAD y, and its cells unchanged in value.",
      "properties": {
        "station_mm": {"type": "number"},
        "y_mm": {"type": "number"},
        "offset_from_joint_mm": {"type": "number", "description": "Signed: the row's CAD y less the joint station's."},
        "values": {"type": "object", "additionalProperties": {"type": "number"}},
        "rays": {"type": "object", "additionalProperties": {"$ref": "#/$defs/ray"}}
      }
    },
    "wrench": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "force_n", "moment_nm"],
      "description": "Force and moment at the interface origin, in the interface frame.",
      "properties": {
        "case": {"type": "string", "minLength": 1, "description": "A load-case id, or a static or inertial row's id."},
        "force_n": {"$ref": "#/$defs/vec3"},
        "moment_nm": {"$ref": "#/$defs/vec3"},
        "moment_band_nm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["low", "high", "over"],
          "properties": {"low": {"type": "number"}, "high": {"type": "number"}, "over": {"type": "string", "minLength": 1}}
        },
        "bsip_spread_pct": {"type": "number", "minimum": 0},
        "tilt_bound_deg": {"type": "number", "minimum": 0},
        "idealised": {"type": "string", "minLength": 1, "description": "What the value assumes that the hardware will not (the shoulder frame's zero moment)."}
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor", "frame", "sections", "wrenches"],
      "properties": {
        "anchor": {"type": "string", "minLength": 1, "description": "The key of `anchors` at the origin."},
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin", "axes"],
          "properties": {
            "origin": {"$ref": "#/$defs/position"},
            "axes": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/vec3"}, "description": "x, y, z as unit vectors in the file's frame."}
          }
        },
        "joint_station_mm": {"type": "number", "description": "The joint's ledger station."},
        "sections": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/section_row"}, "description": "The two ledger rows that bracket the joint station, not interpolated."},
        "wrenches": {"type": "array", "items": {"$ref": "#/$defs/wrench"}}
      }
    },
    "static_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface", "payload", "payload_kg", "claim", "angles_deg", "max_force_n", "max_moment_nm", "max_force_mag_n", "max_moment_mag_nm", "governing_direction", "bsip_spread_pct"],
      "description": "Gravity over the whole sphere (brief decision 4) on everything distal of an interface, maximised analytically per component and in magnitude, at every elbow angle of the travel.",
      "properties": {
        "interface": {"type": "string", "minLength": 1},
        "payload": {"type": "string", "minLength": 1},
        "payload_kg": {"type": "number", "minimum": 0},
        "claim": {"type": "string", "minLength": 1},
        "angles_deg": {"type": "array", "items": {"type": "number"}},
        "max_force_n": {"type": "array", "items": {"$ref": "#/$defs/vec3"}},
        "max_moment_nm": {"type": "array", "items": {"$ref": "#/$defs/vec3"}},
        "max_force_mag_n": {"type": "array", "items": {"type": "number"}},
        "max_moment_mag_nm": {"type": "array", "items": {"type": "number"}},
        "governing_direction": {"type": "array", "items": {"$ref": "#/$defs/vec3"}},
        "bsip_spread_pct": {"type": "number", "minimum": 0},
        "tilt_bound_deg": {"type": "number", "minimum": 0}
      }
    },
    "inertial_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "interface", "amplitude_deg", "duration_s", "payload_kg", "inertia_kgm2", "peak_speed_rad_s", "peak_accel_rad_s2", "max_force_n", "max_moment_nm", "provisional", "basis"],
      "properties": {
        "row": {"type": "string", "pattern": "^S[0-9]+$"},
        "interface": {"type": "string", "minLength": 1},
        "amplitude_deg": {"type": "number"},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "payload_kg": {"type": "number", "minimum": 0},
        "inertia_kgm2": {"type": "number", "minimum": 0},
        "peak_speed_rad_s": {"type": "number"},
        "peak_accel_rad_s2": {"type": "number"},
        "start_angles_deg": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "max_force_n": {"$ref": "#/$defs/vec3"},
        "max_moment_nm": {"$ref": "#/$defs/vec3"},
        "bsip_spread_pct": {"type": "number", "minimum": 0},
        "tilt_bound_deg": {"type": "number", "minimum": 0},
        "provisional": {"type": "boolean"},
        "basis": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citation"}}
      }
    },
    "fall_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case", "reaches_by", "energy_j", "direction", "contact", "flag", "basis", "provisional"],
      "description": "A fall case that reaches the segment through fall_cases or fall_contacts (adr-0045 D5(c)), with its (case, segment) flag (D5(e)).",
      "properties": {
        "case": {"$ref": "#/$defs/case_id"},
        "reaches_by": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["fall_cases", "fall_contacts"]}},
        "energy_j": {"type": "number", "exclusiveMinimum": 0},
        "direction": {"type": "string", "minLength": 1},
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "position"],
          "properties": {
            "description": {"type": "string", "minLength": 1},
            "station_mm": {"type": "number"},
            "position": {"$ref": "#/$defs/position"},
            "normal": {"$ref": "#/$defs/vec3"},
            "skin_depth_mm": {"type": "number"}
          }
        },
        "flag": {"enum": ["structural", "clearance"]},
        "basis": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citation"}},
        "provisional": {"type": "boolean"},
        "rating": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value_n", "kind", "basis"],
          "properties": {
            "value_n": {"type": "number", "exclusiveMinimum": 0},
            "kind": {"type": "string", "minLength": 1},
            "basis": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citation"}}
          }
        },
        "wrenches": {"type": "object", "additionalProperties": {"$ref": "#/$defs/wrench"}, "description": "By interface name."},
        "clearance_mm": {"type": ["number", "null"]},
        "open": {"type": "array", "items": {"$ref": "#/$defs/open_item"}}
      }
    },
    "open_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantity", "reason", "waits_on"],
      "properties": {
        "quantity": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "waits_on": {"type": "string", "minLength": 1}
      }
    }
  }
}
