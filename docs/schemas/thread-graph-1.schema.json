{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "thread-graph/1",
  "title": "thread-graph/1",
  "description": "thread/graph.json (generated by `fy thread build`): the records as nodes, the authored and derived relations as edges, the registry of edge types (the one place each relationship is documented), the work statuses and the mass budget. Carries the CONVENTIONS section 4 banner as top-level generated_by and inputs. Deterministic: sorted nodes and edges.",
  "type": "object",
  "required": [
    "schema",
    "generated_by",
    "inputs",
    "nodes",
    "edges",
    "edge_types",
    "work_statuses",
    "budgets"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "thread-graph/1"
    },
    "generated_by": {
      "type": "string"
    },
    "inputs": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{12}$"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(seg|jnt|part|if|lc|hn|work)[.][a-z0-9_.-]+$"
          },
          "kind": {
            "enum": [
              "segment",
              "joint",
              "part",
              "interface",
              "load_case",
              "harness_run",
              "work_item"
            ]
          },
          "status": {
            "enum": [
              "proposed",
              "active",
              "superseded"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "from",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      }
    },
    "edge_types": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "from_kinds",
          "to_kinds",
          "origin",
          "doc"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "from_kinds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "to_kinds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "origin": {
            "enum": [
              "authored",
              "derived"
            ]
          },
          "doc": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "work_statuses": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "unstamped",
          "current",
          "stale",
          "drifted",
          "unknown",
          "reverified"
        ]
      }
    },
    "budgets": {
      "type": "object",
      "required": [
        "mass"
      ],
      "properties": {
        "mass": {
          "type": "object",
          "required": [
            "body",
            "segments"
          ],
          "properties": {
            "body": {
              "type": "object",
              "required": [
                "target_kg",
                "claimed_kg",
                "over"
              ],
              "properties": {
                "target_kg": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "claimed_kg": {
                  "type": "number"
                },
                "over": {
                  "type": "boolean"
                }
              }
            },
            "segments": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "target_kg",
                  "claimed_kg",
                  "over"
                ],
                "properties": {
                  "target_kg": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "claimed_kg": {
                    "type": "number"
                  },
                  "over": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
