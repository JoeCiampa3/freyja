{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roadmap-state/1",
  "title": "roadmap-state/1",
  "description": "The generated state of the roadmap (roadmap/state.json), written by `fy roadmap build` (tools/roadmap; CONVENTIONS section 4 for the banner, docs/briefs/architecture/roadmap-brief1.md for the rules). Deterministic: sorted keys and ids, repo-relative paths, no timestamps. `status` is derived on every build and never authored. Leaf statuses: done, blocked, active, ready. Stub statuses: blocked, expandable. Interior statuses: done, blocked, in_progress, not_started. `superseded` nodes are excluded from every count and from the frontier. `unknown` appears only when a status cannot be derived because the graph has errors (the server may return such a state; `fy roadmap build` writes nothing on errors). `stale` is reserved and never emitted. `counts` covers non-superseded nodes only.",
  "type": "object",
  "required": ["_generated", "generated_by", "inputs", "schema", "node_count", "superseded_count", "counts", "frontier", "errors", "warnings", "nodes"],
  "additionalProperties": false,
  "properties": {
    "_generated": {"type": "string", "description": "The banner."},
    "generated_by": {"type": "string"},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "schema": {"const": "roadmap-state/1"},
    "node_count": {"type": "integer", "minimum": 0, "description": "Non-superseded nodes."},
    "superseded_count": {"type": "integer", "minimum": 0},
    "counts": {"type": "object", "propertyNames": {"$ref": "#/$defs/status"}, "additionalProperties": {"type": "integer", "minimum": 0}},
    "frontier": {"type": "array", "items": {"type": "string"}, "description": "Every ready leaf and every expandable stub, sorted by id."},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "nodes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/node"}}
  },
  "$defs": {
    "status": {"enum": ["done", "blocked", "active", "ready", "expandable", "in_progress", "not_started", "superseded", "stale", "unknown"]},
    "issue": {
      "type": "object", "required": ["code", "message", "ids", "paths"], "additionalProperties": false,
      "properties": {"code": {"type": "string"}, "message": {"type": "string"},
                     "ids": {"type": "array", "items": {"type": "string"}}, "paths": {"type": "array", "items": {"type": "string"}}}
    },
    "node": {
      "type": "object",
      "required": ["title", "path", "kind", "status", "reason", "parent", "children", "blocked_by", "effective_blockers", "uncleared_blockers", "dependents",
                   "estimate_days", "tags", "active", "signed_off", "superseded_by", "done_when", "evaluation"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string"},
        "path": {"type": "string", "description": "Repo-relative path of the node file."},
        "kind": {"enum": ["interior", "leaf", "stub", "superseded", "unknown"]},
        "status": {"$ref": "#/$defs/status"},
        "reason": {"type": "string"},
        "parent": {"type": ["string", "null"]},
        "children": {"type": "array", "items": {"type": "string"}, "description": "Non-superseded children, sorted by id."},
        "blocked_by": {"type": "array", "items": {"type": "string"}},
        "effective_blockers": {"type": "array", "items": {"type": "string"}, "description": "Own blocked_by plus every ancestor's."},
        "uncleared_blockers": {"type": "array", "items": {"type": "string"}},
        "dependents": {"type": "array", "items": {"type": "string"}, "description": "Nodes whose effective blockers include this one."},
        "estimate_days": {"type": ["number", "null"]},
        "tags": {"type": "array", "items": {"type": "string"}},
        "active": {"type": "boolean"},
        "signed_off": {"type": "boolean"},
        "superseded_by": {"type": ["string", "null"]},
        "done_when": {"type": ["object", "null"]},
        "evaluation": {
          "type": ["object", "null"],
          "required": ["result", "reason", "measured"], "additionalProperties": false,
          "properties": {"result": {"enum": ["pass", "fail", "unknown"]}, "reason": {"type": "string"}, "measured": {"type": ["number", "null"]}}
        }
      }
    }
  }
}
